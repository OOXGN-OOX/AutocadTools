<Project>
  <PropertyGroup>
    <AutoCADVersion Condition="'$(AutoCADVersion)' == ''">2027</AutoCADVersion>
    <BaseIntermediateOutputPath>obj\AutoCAD$(AutoCADVersion)\</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**;artifacts\**;.agents\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
