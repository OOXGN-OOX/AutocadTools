<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AutoCADVersion Condition="'$(AutoCADVersion)' == ''">2026</AutoCADVersion>
    <TargetFramework Condition="'$(AutoCADVersion)' != '2027'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(AutoCADVersion)' == '2027'">net10.0-windows</TargetFramework>
    <AssemblyName>AutocadTools.CommandPreview.$(RunnerRevision)</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AutoCADPath Condition="'$(AutoCADPath)' == ''">C:\Program Files\Autodesk\AutoCAD $(AutoCADVersion)</AutoCADPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="obj/CommandMethods.g.cs" />
    <Reference Include="AcCoreMgd"><HintPath>$(AutoCADPath)\accoremgd.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AutoCADPath)\acdbmgd.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="AcMgd"><HintPath>$(AutoCADPath)\acmgd.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>
</Project>
