<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AutocadTools.Views.PlanPrepWindow" Title="Подготовка плана" Width="530" Height="640" MinWidth="490" MinHeight="600" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Style="{DynamicResource ToolWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Подготовка плана" Style="{StaticResource TitleStyle}"/>
            <TextBlock Text="Упростите геометрию перед дальнейшей работой." Style="{StaticResource DescriptionStyle}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <GroupBox Header="Геометрия и очистка">
                    <StackPanel>
                        <CheckBox Content="Расчленить блоки, включая вложенные" IsChecked="{Binding Options.ExplodeAllBlocks}"/>
                        <CheckBox Content="Расчленить штриховки" IsChecked="{Binding Options.ExplodeHatches}"/>
                        <CheckBox Content="Удалить сплошные штриховки" IsChecked="{Binding Options.DeleteSolidHatches}"/>
                        <CheckBox Content="Удалить маскировки" IsChecked="{Binding Options.DeleteWipeouts}"/>
                        <CheckBox Content="Удалить точки" IsChecked="{Binding Options.DeletePoints}"/>
                        <CheckBox Content="Соединить линии в полилинии" IsChecked="{Binding Options.JoinLines}"/>
                        <CheckBox Content="Удалить сегменты короче 0,01 ед." IsChecked="{Binding Options.DeleteShortSegments}"/>
                        <CheckBox Content="Установить серый цвет (8)" IsChecked="{Binding Options.SetGrayColor}"/>
                    </StackPanel>
                </GroupBox>
                <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                    <CheckBox Content="Собрать результат в единый блок" IsChecked="{Binding Options.CreateBlock}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <ContentControl Grid.Row="2">
            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,20,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Отмена" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="104" Margin="8,0,0,0"/>
                        <Button Content="Выполнить" Command="{Binding ExecuteCommand}" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="104" Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </ContentControl>
    </Grid>
</Window>
