<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:AutocadTools.Models" x:Class="AutocadTools.Views.SumLengthWindow" Title="Сумма длин" Height="620" Width="480" MinHeight="560" MinWidth="460" ResizeMode="CanResizeWithGrip" Topmost="True" WindowStartupLocation="CenterScreen" Closing="Window_Closing" Style="{DynamicResource ToolWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 1. Total Length + Area with separate copy -->
        <Border Grid.Row="0" Padding="0,0,0,12" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Length -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Общая длина / Периметр" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                    <Button Style="{StaticResource ClickableValueStyle}" Command="{Binding CopyLengthCommand}" ToolTip="Скопировать длину">
                        <TextBlock Text="{Binding TotalLengthFormatted}" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    </Button>
                </StackPanel>
                <!-- Length Unit selector -->
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding LengthUnits}" SelectedItem="{Binding SelectedLengthUnit}" Style="{StaticResource {x:Type ComboBox}}" VerticalAlignment="Bottom" Width="76" Margin="8,0,0,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="{DynamicResource TextPrimary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="Millimeters">
                                                <Setter Property="Text" Value="мм"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="Meters">
                                                <Setter Property="Text" Value="м"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="Kilometers">
                                                <Setter Property="Text" Value="км"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <!-- Area (if available) -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0" Visibility="{Binding HasTotalArea, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="Общая площадь" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                    <Button Style="{StaticResource ClickableValueStyle}" Command="{Binding CopyAreaCommand}" ToolTip="Скопировать площадь">
                        <TextBlock Text="{Binding TotalAreaFormatted}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                    </Button>
                </StackPanel>
                <!-- Area Unit selector -->
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AreaUnits}" SelectedItem="{Binding SelectedAreaUnit}" Style="{StaticResource {x:Type ComboBox}}" VerticalAlignment="Bottom" Width="76" Margin="8,12,0,0" Visibility="{Binding HasTotalArea, Converter={StaticResource BoolToVisConverter}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="{DynamicResource TextPrimary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="SquareMillimeters">
                                                <Setter Property="Text" Value="мм²"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="SquareMeters">
                                                <Setter Property="Text" Value="м²"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="SquareKilometers">
                                                <Setter Property="Text" Value="км²"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>
        <!-- 2. Scale -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Масштаб" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding ScaleNumerator, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource {x:Type TextBox}}" HorizontalContentAlignment="Center"/>
                <TextBlock Grid.Column="2" Text=" : " Foreground="{DynamicResource TextSecondary}" FontSize="16" VerticalAlignment="Center" Margin="4,0"/>
                <TextBox Grid.Column="3" Text="{Binding ScaleDenominator, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource {x:Type TextBox}}" HorizontalContentAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{Binding ScaleInfo}" Style="{StaticResource LabelStyle}" Margin="8,0,0,0" FontStyle="Italic"/>
            </Grid>
        </Border>
        <!-- 3. Stats -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Объектов" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding TotalCount}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Типов" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding GroupCount}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- 4. List of Groups with Items -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                            <Expander IsExpanded="False" Padding="0,8" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <Grid MinWidth="320">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ObjectType}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                            <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12">
                                                <Run Text="{Binding Count, Mode=OneWay}"/>
                                                <Run Text=" шт."/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalLengthFormatted}" Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding TotalAreaFormatted}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Visibility="{Binding HasArea, Converter={StaticResource BoolToVisConverter}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>
                                <!-- Items List -->
                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ItemButtonStyle}" Command="{Binding DataContext.ZoomToObjectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding CoordinatesInfo}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding LengthFormatted}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                                        <TextBlock Text="{Binding AreaFormatted}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Visibility="{Binding HasArea, Converter={StaticResource BoolToVisConverter}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
