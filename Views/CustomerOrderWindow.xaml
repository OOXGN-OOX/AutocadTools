<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AutocadTools.Views.CustomerOrderWindow" Title="Файл для заказчика" Width="530" Height="560" MinWidth="490" MinHeight="520" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Style="{DynamicResource ToolWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Файл для заказчика" Style="{StaticResource TitleStyle}"/>
            <TextBlock Text="Настройте состав и обработку передаваемого чертежа." Style="{StaticResource DescriptionStyle}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <GroupBox Header="Файл">
                    <StackPanel>
                        <CheckBox Content="Создать новый файл" IsChecked="{Binding CreateNewFile}"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Содержимое">
                    <StackPanel>
                        <CheckBox Content="Расчленить блоки" IsChecked="{Binding ExplodeBlocks}"/>
                        <CheckBox Content="Расчленить полилинии" IsChecked="{Binding ExplodePolylines}"/>
                        <CheckBox Content="Расчленить текст" IsChecked="{Binding ExplodeText}"/>
                        <CheckBox Content="Удалить неиспользуемые данные" IsChecked="{Binding PurgeUnused}"/>
                        <CheckBox Content="Запретить копирование" IsChecked="{Binding BlockCopy}"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
        <ContentControl Grid.Row="2">
            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,20,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Отмена" IsCancel="True" Click="Cancel_Click" MinWidth="104"/>
                        <Button Content="Подготовить" IsDefault="True" Click="Ok_Click" Style="{StaticResource PrimaryButton}" MinWidth="120" Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </ContentControl>
    </Grid>
</Window>
