<Window x:Class="AutocadTools.Views.CustomerOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сформировать заказчику"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
	<StackPanel Margin="14" MinWidth="440">
		<TextBlock Text="Выберите операции:"
                   FontSize="14"
                   Margin="0,0,0,10"/>

		<CheckBox Content="Создать новый файл"
                  IsChecked="{Binding CreateNewFile}"
                  Margin="0,0,0,6"/>

		<CheckBox Content="Расчленить блоки"
                  IsChecked="{Binding ExplodeBlocks}"
                  Margin="0,0,0,6"/>

		<CheckBox Content="Расчленить полилинии"
                  IsChecked="{Binding ExplodePolylines}"
                  Margin="0,0,0,6"/>

		<CheckBox Content="Расчленить текст"
                  IsChecked="{Binding ExplodeText}"
                  Margin="0,0,0,6"/>

		<CheckBox Content="Выполнить очистку"
                  IsChecked="{Binding PurgeUnused}"
                  Margin="0,0,0,6"/>

		<CheckBox Content="Запретить копирование"
                  IsChecked="{Binding BlockCopy}"
                  Margin="0,0,0,12"/>

		<DockPanel LastChildFill="False">
			<Button Content="OK"
                    Width="120"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="Ok_Click" />
			<Button Content="Отмена"
                    Width="120"
                    IsCancel="True"
                    Click="Cancel_Click" />
		</DockPanel>
	</StackPanel>
</Window>
