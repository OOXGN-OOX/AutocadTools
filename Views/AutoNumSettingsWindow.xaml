<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AutocadTools.Views.AutoNumSettingsWindow" Title="Автонумерация" Width="740" Height="650" MinWidth="700" MinHeight="610" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Style="{DynamicResource ToolWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Автонумерация" Style="{StaticResource TitleStyle}"/>
            <TextBlock Text="Задайте формат номера и порядок обработки объектов." Style="{StaticResource DescriptionStyle}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <GroupBox Header="Нумерация" Margin="0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="Префикс" Style="{StaticResource LabelStyle}" Margin="0,0,0,7"/>
                                            <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Префикс"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="Суффикс" Style="{StaticResource LabelStyle}" Margin="0,0,0,7"/>
                                            <TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Суффикс"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Начальный номер" Style="{StaticResource LabelStyle}" Margin="0,0,0,7"/>
                                    <TextBox Text="{Binding StartNumberText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Начальный номер"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="Шаг" Style="{StaticResource LabelStyle}" Margin="0,0,0,7"/>
                                            <TextBox Text="{Binding StepText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Шаг"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="Количество знаков" Style="{StaticResource LabelStyle}" Margin="0,0,0,7"/>
                                            <TextBox Text="{Binding DigitsText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Количество знаков"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <GroupBox Header="Объекты и порядок" Margin="0">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Порядок" Style="{StaticResource LabelStyle}" Margin="0,0,0,7"/>
                                    <ComboBox SelectedIndex="{Binding OrderIndex}" AutomationProperties.Name="Порядок">
                                        <ComboBoxItem Content="В порядке выбора"/>
                                        <ComboBoxItem Content="Сортировка"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12" Visibility="{Binding IsSortingModeVisibility}">
                                    <TextBlock Text="Направление сортировки" Style="{StaticResource LabelStyle}" Margin="0,0,0,7"/>
                                    <ComboBox SelectedIndex="{Binding SortingIndex}" AutomationProperties.Name="Направление сортировки">
                                        <ComboBoxItem Content="По строкам сверху вниз"/>
                                        <ComboBoxItem Content="По строкам снизу вверх"/>
                                        <ComboBoxItem Content="По столбцам слева направо"/>
                                        <ComboBoxItem Content="По столбцам справа налево"/>
                                        <ComboBoxItem Content="По горизонтали"/>
                                        <ComboBoxItem Content="По вертикали"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Тип объекта" Style="{StaticResource LabelStyle}" Margin="0,0,0,7"/>
                                    <ComboBox SelectedIndex="{Binding ModeIndex}" AutomationProperties.Name="Тип объекта">
                                        <ComboBoxItem Content="Текст / МТекст"/>
                                        <ComboBoxItem Content="Мультивыноска"/>
                                        <ComboBoxItem Content="Атрибут блока"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsAttributeModeVisibility}">
                                    <TextBlock Text="Тег атрибута" Style="{StaticResource LabelStyle}" Margin="0,0,0,7"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshAttributesCommand}" Margin="8,0,0,0" Padding="10,6"/>
                                        <ComboBox ItemsSource="{Binding AvailableAttributes}" SelectedItem="{Binding AttributeTag}" IsEditable="True" Text="{Binding AttributeTag, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Тег атрибута"/>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <ContentControl Grid.Row="3">
            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,20,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Отмена" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="104" Margin="8,0,0,0"/>
                        <Button Content="Применить" Command="{Binding OkCommand}" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="104" Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </ContentControl>
        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,12,0,0" Grid.Row="2">
            <StackPanel>
                <TextBlock Text="Пример нумерации" Style="{StaticResource LabelStyle}" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding PreviewItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="20" FontWeight="SemiBold" Margin="0,0,24,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</Window>
