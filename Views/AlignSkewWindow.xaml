<Window x:Class="AutocadTools.Views.AlignSkewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutocadTools.Views"
        mc:Ignorable="d"
        Title="Настройки выравнивания (Align_Den)"
        Height="400" Width="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F0F0F0">

	<!-- Подключаем ресурсы (Конвертер) -->
	<Window.Resources>
		<local:InverseBooleanConverter x:Key="InverseBoolConverter"/>

		<!-- Стиль для групповых рамок -->
		<Style TargetType="GroupBox">
			<Setter Property="Margin" Value="0,0,0,10"/>
			<Setter Property="Padding" Value="5"/>
			<Setter Property="FontWeight" Value="Bold"/>
		</Style>

		<!-- Стиль для чекбоксов и радиокнопок -->
		<Style TargetType="CheckBox">
			<Setter Property="Margin" Value="0,3"/>
			<Setter Property="FontWeight" Value="Normal"/>
		</Style>
		<Style TargetType="RadioButton">
			<Setter Property="Margin" Value="0,3"/>
			<Setter Property="FontWeight" Value="Normal"/>
		</Style>
	</Window.Resources>

	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0">
			<!-- Блок 1: Режим -->
			<GroupBox Header="Режим работы">
				<StackPanel>
					<RadioButton Content="Полный набор функций"
                                 IsChecked="{Binding IsFullFunction}"/>
					<RadioButton Content="Только наклон (Аксонометрия)"
                                 IsChecked="{Binding IsFullFunction, Converter={StaticResource InverseBoolConverter}}"/>
				</StackPanel>
			</GroupBox>

			<!-- Блок 2: Опции -->
			<GroupBox Header="Настройки обработки">
				<StackPanel>
					<CheckBox Content="С сохранением свойств текста"
                              IsChecked="{Binding PreserveTextProperties}"/>
					<CheckBox Content="Предварительно расчленить размеры"
                              IsChecked="{Binding ExplodeDimensions}"/>
					<CheckBox Content="Предварительно расчленить выноски"
                              IsChecked="{Binding ExplodeLeaders}"/>
				</StackPanel>
			</GroupBox>

			<!-- Блок 3: Блоки -->
			<GroupBox Header="Обработка блоков">
				<StackPanel>
					<RadioButton Content="Предварительно расчленить блоки"
                                 IsChecked="{Binding IsBlockExplode}"/>
					<RadioButton Content="Переместить блоки (без искажения)"
                                 IsChecked="{Binding IsBlockMove}"/>
					<RadioButton Content="Без обработки"
                                 IsChecked="{Binding IsBlockNone}"/>
				</StackPanel>
			</GroupBox>
		</StackPanel>

		<!-- Кнопка Выполнить -->
		<Button Grid.Row="1"
                Content="Выполнить"
                Command="{Binding RunCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                Height="35"
                Margin="0,10,0,0"
                FontWeight="Bold"/>
	</Grid>
</Window>