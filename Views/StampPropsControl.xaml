                                <Border Style="{StaticResource StampCellBorder}" Grid.Column="5"><TextBox Style="{StaticResource StampTextBox}" AutomationProperties.Name="Дата.7" Text="{Binding FieldsMap[Дата.7].Value, UpdateSourceTrigger=PropertyChanged}"/></Border>
                            </Grid>

                            <!-- Заголовки -->
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38*"/>
                                    <ColumnDefinition Width="38*"/>
                                    <ColumnDefinition Width="38*"/>
                                    <ColumnDefinition Width="38*"/>
                                    <ColumnDefinition Width="57*"/>
                                    <ColumnDefinition Width="38*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StampCellBorder}" Grid.Column="0"><TextBlock Text="Изм." HorizontalAlignment="Center"/></Border>
                                <Border Style="{StaticResource StampCellBorder}" Grid.Column="1"><TextBlock Text="Кол." HorizontalAlignment="Center"/></Border>
                                <Border Style="{StaticResource StampCellBorder}" Grid.Column="2"><TextBlock Text="Лист" HorizontalAlignment="Center"/></Border>
