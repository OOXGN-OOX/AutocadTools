                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StampCellBorder}" Grid.Column="0"><TextBox Style="{StaticResource StampTextBox}" AutomationProperties.Name="Должн.4" Text="{Binding FieldsMap[Должн.4].Value, UpdateSourceTrigger=PropertyChanged}"/></Border>
                                <Border Style="{StaticResource StampCellBorder}" Grid.Column="1"><TextBox Style="{StaticResource StampTextBox}" AutomationProperties.Name="Фам.4" Text="{Binding FieldsMap[Фам.4].Value, UpdateSourceTrigger=PropertyChanged}"/></Border>
                                <Border Style="{StaticResource StampCellBorder}" Grid.Column="2"><Button Style="{StaticResource SignatureCell}" Click="Signature_Click" Tag="Signer4" ToolTip="{Binding Signatures[Signer4].Hint}" AutomationProperties.Name="Подпись Signer4"><Image Source="{Binding Signatures[Signer4].Image}" Stretch="Uniform" Margin="2"/></Button></Border>
