                            <TextBlock Text="Подп. и дата" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                            <TextBox Style="{StaticResource StampTextBox}" AutomationProperties.Name="Подп.и.дата" Text="{Binding FieldsMap[Подп.и.дата].Value, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </TextBox.LayoutTransform>
                            </TextBox>
                        </Grid>
                    </Border>

                    <!-- Инв № подл -->
                    <Border Style="{StaticResource StampCellBorder}" Grid.Row="3" Background="{DynamicResource InputBackground}" BorderThickness="1" BorderBrush="{DynamicResource TextSecondary}" Height="95">
                        <Grid>
                            <TextBlock Text="Инв. № подл." VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                            <TextBox Style="{StaticResource StampTextBox}" AutomationProperties.Name="Инв.№" Text="{Binding FieldsMap[Инв.№].Value, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </TextBox.LayoutTransform>
                            </TextBox>
                        </Grid>
                    </Border>
                </Grid>

