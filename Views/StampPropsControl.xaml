                                <Border Style="{StaticResource StampCellBorder}" Grid.Column="1"><TextBox Style="{StaticResource StampTextBox}" AutomationProperties.Name="Кол.уч.3" Text="{Binding FieldsMap[Кол.уч.3].Value, UpdateSourceTrigger=PropertyChanged}"/></Border>
