                                    <ColumnDefinition Width="57*"/>
                                    <ColumnDefinition Width="38*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StampCellBorder}" Grid.Column="0"><TextBox Style="{StaticResource StampTextBox}" AutomationProperties.Name="Должн.1" Text="{Binding FieldsMap[Должн.1].Value, UpdateSourceTrigger=PropertyChanged}"/></Border>
                                <Border Style="{StaticResource StampCellBorder}" Grid.Column="1"><TextBox Style="{StaticResource StampTextBox}" AutomationProperties.Name="Фам.1" Text="{Binding FieldsMap[Фам.1].Value, UpdateSourceTrigger=PropertyChanged}"/></Border>
                                <Border Style="{StaticResource StampCellBorder}" Grid.Column="2"><Button Style="{StaticResource SignatureCell}" Click="Signature_Click" Tag="Signer1" ToolTip="{Binding Signatures[Signer1].Hint}" AutomationProperties.Name="Подпись Signer1"><Image Source="{Binding Signatures[Signer1].Image}" Stretch="Uniform" Margin="2"/></Button></Border>
                                <Border Style="{StaticResource StampCellBorder}" Grid.Column="3"><TextBox Style="{StaticResource StampTextBox}" AutomationProperties.Name="Дата.1" Text="{Binding FieldsMap[Дата.1].Value, UpdateSourceTrigger=PropertyChanged}"/></Border>
                            </Grid>
                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76*"/>
                                    <ColumnDefinition Width="76*"/>
                                    <ColumnDefinition Width="57*"/>
                                    <ColumnDefinition Width="38*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StampCellBorder}" Grid.Column="0"><TextBox Style="{StaticResource StampTextBox}" AutomationProperties.Name="Должн.2" Text="{Binding FieldsMap[Должн.2].Value, UpdateSourceTrigger=PropertyChanged}"/></Border>
                                <Border Style="{StaticResource StampCellBorder}" Grid.Column="1"><TextBox Style="{StaticResource StampTextBox}" AutomationProperties.Name="Фам.2" Text="{Binding FieldsMap[Фам.2].Value, UpdateSourceTrigger=PropertyChanged}"/></Border>
                                <Border Style="{StaticResource StampCellBorder}" Grid.Column="2"><Button Style="{StaticResource SignatureCell}" Click="Signature_Click" Tag="Signer2" ToolTip="{Binding Signatures[Signer2].Hint}" AutomationProperties.Name="Подпись Signer2"><Image Source="{Binding Signatures[Signer2].Image}" Stretch="Uniform" Margin="2"/></Button></Border>
                                <Border Style="{StaticResource StampCellBorder}" Grid.Column="3"><TextBox Style="{StaticResource StampTextBox}" AutomationProperties.Name="Дата.2" Text="{Binding FieldsMap[Дата.2].Value, UpdateSourceTrigger=PropertyChanged}"/></Border>
                            </Grid>
                            <Grid Grid.Row="7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76*"/>
                                    <ColumnDefinition Width="76*"/>
                                    <ColumnDefinition Width="57*"/>
                                    <ColumnDefinition Width="38*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StampCellBorder}" Grid.Column="0"><TextBox Style="{StaticResource StampTextBox}" AutomationProperties.Name="Должн.3" Text="{Binding FieldsMap[Должн.3].Value, UpdateSourceTrigger=PropertyChanged}"/></Border>
