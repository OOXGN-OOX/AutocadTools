                                    <ColumnDefinition Width="76*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StampCellBorder}" Grid.Column="0">
                                    <Grid>
                                        <TextBlock Style="{StaticResource StampHint}" Text="Наименование здания"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource StampTextBox}" Grid.ColumnSpan="2" FontSize="{Binding Typography.Building.FontSize}" FontFamily="{Binding Typography.Building.FontFamily}" TextWrapping="Wrap" TextAlignment="Center" AcceptsReturn="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center" Margin="0,8,0,0" Padding="3.8,0" MaxLength="1000" Text="{Binding НаименованиеУчастка, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource StampCellBorder}" Grid.Column="1">
                                    <Grid>
                                        <TextBlock Text="Стадия" HorizontalAlignment="Center"/>
                                        <TextBox Style="{StaticResource StampTextBox}" AutomationProperties.Name="Стадия" Margin="0,12,0,0" HorizontalContentAlignment="Center" Text="{Binding FieldsMap[Стадия].Value, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource StampCellBorder}" Grid.Column="2">
                                    <Grid>
                                        <TextBlock Text="Лист" HorizontalAlignment="Center"/>
                                        <TextBox Style="{StaticResource StampTextBox}" IsReadOnly="True" Text="auto" Margin="0,12,0,0" HorizontalContentAlignment="Center" Background="{DynamicResource InputBackground}"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource StampCellBorder}" Grid.Column="3">
                                    <Grid>
                                        <TextBlock Text="Листов" HorizontalAlignment="Center"/>
                                        <TextBox Style="{StaticResource StampTextBox}" AutomationProperties.Name="Листов" Margin="0,12,0,0" HorizontalContentAlignment="Center" Text="{Binding FieldsMap[Листов].Value, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Наименование + Компания -->
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="266*"/>
                                    <ColumnDefinition Width="190*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StampCellBorder}" Grid.Column="0">
                                    <Grid>
                                        <TextBlock Style="{StaticResource StampHint}" Text="Наименование" VerticalAlignment="Top"/>
                                        <TextBox Style="{StaticResource StampTextBox}" IsReadOnly="True" Background="{DynamicResource InputBackground}"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource StampCellBorder}" Grid.Column="1">
                                    <Grid>
                                        <TextBlock Style="{StaticResource StampHint}" Text="Компания"/>
                                        <TextBox Style="{StaticResource StampTextBox}" AutomationProperties.Name="Компания" FontSize="{Binding Typography.Company.FontSize}" FontFamily="{Binding Typography.Company.FontFamily}" TextWrapping="Wrap" TextAlignment="Center" AcceptsReturn="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="{Binding FieldsMap[Компания].Value, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Viewbox>

        <Button Grid.Row="1" Content="Подписи…" Click="Signature_Click" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="Загрузить PNG, нарисовать или выбрать сохранённую подпись"/>
        <!-- КНОПКИ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,5,0,0">
            <Button Content="Обновить из чертежа" Command="{Binding RefreshCommand}" Style="{StaticResource {x:Type Button}}" Margin="0,0,10,0"/>
            <Button Content="Записать в DWG" Click="WriteDrawing" Margin="0,0,8,0"/>
            <Button Content="Записать в Word" Click="WriteWord" Margin="0,0,8,0"/>
            <Button Content="Применить" Command="{Binding UpdateCommand}" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
