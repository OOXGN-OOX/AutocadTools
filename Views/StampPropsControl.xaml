                                    <ColumnDefinition Width="57*"/>
                                    <ColumnDefinition Width="38*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StampCellBorder}" Grid.Column="0"><TextBox Style="{StaticResource StampTextBox}" AutomationProperties.Name="Изм.1" Text="{Binding FieldsMap[Изм.1].Value, UpdateSourceTrigger=PropertyChanged}"/></Border>
