<Window x:Class="AutocadTools.Views.SelectSimilarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ВЫБОР ПО ОБРАЗЦУ" 
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="ControlBackground" Color="#2D2D30"/>
        <SolidColorBrush x:Key="ControlBorder" Color="#434346"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="CheckedColor" Color="#666666"/>

        <!-- CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="checkBorder" Width="14" Height="14" 
                                    Background="#252526" BorderBrush="{StaticResource ControlBorder}" 
                                    BorderThickness="1" CornerRadius="3" VerticalAlignment="Center">
                                <Path x:Name="checkMark" Data="M2,4 L4,6 L8,2" 
                                      Stroke="{StaticResource TextPrimary}" StrokeThickness="1.5" 
                                      Visibility="Collapsed" Margin="1"/>
                            </Border>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="checkBorder" Property="Background" Value="{StaticResource CheckedColor}"/>
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="{StaticResource CheckedColor}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GroupBox Style -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{TemplateBinding Header}" 
                                       Foreground="{StaticResource TextSecondary}" 
                                       FontSize="11" FontWeight="SemiBold" 
                                       Margin="0,0,0,4"/>
                            <Border Grid.Row="1" Background="#252526" 
                                    BorderBrush="{StaticResource ControlBorder}" 
                                    BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#555555"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderThickness="0" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#666666"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Общие настройки -->
        <GroupBox Header="ОБЩИЕ НАСТРОЙКИ">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <CheckBox Content="Добавлять объекты-образцы в набор" IsChecked="{Binding Options.AddSourceObjects}"/>
                    <CheckBox Content="Одинаковые типы" IsChecked="{Binding Options.MatchType}"/>
                    <CheckBox Content="На одинаковом слое" IsChecked="{Binding Options.MatchLayer}"/>
                    <CheckBox Content="С одинаковым цветом" IsChecked="{Binding Options.MatchColor}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <CheckBox Content="С одинаковым типом линий" IsChecked="{Binding Options.MatchLinetype}"/>
                    <CheckBox Content="С одинаковым масштабом типа линий" IsChecked="{Binding Options.MatchLinetypeScale}"/>
                    <CheckBox Content="С одинаковым весом линий" IsChecked="{Binding Options.MatchLineWeight}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Специфичные настройки -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка -->
            <StackPanel Grid.Column="0">
                <GroupBox Header="БЛОКИ">
                    <StackPanel>
                        <CheckBox Content="Именем блока" IsChecked="{Binding Options.BlockName}"/>
                        <CheckBox Content="Масштабом блока" IsChecked="{Binding Options.BlockScale}"/>
                        <CheckBox Content="Значением любого атрибута" IsChecked="{Binding Options.BlockAnyAttribute}"/>
                        <CheckBox Content="Значением всех атрибутов" IsChecked="{Binding Options.BlockAllAttributes}"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="МУЛЬТИВЫНОСКИ">
                    <CheckBox Content="Содержимым текста" IsChecked="{Binding Options.MLeaderContent}"/>
                </GroupBox>
                <GroupBox Header="ОТРЕЗКИ">
                    <CheckBox Content="Длиной отрезка" IsChecked="{Binding Options.LineLength}"/>
                </GroupBox>
                <GroupBox Header="РАЗМЕРЫ">
                    <StackPanel>
                        <CheckBox Content="Величиной размера" IsChecked="{Binding Options.DimValue}"/>
                        <CheckBox Content="Текстовой строкой" IsChecked="{Binding Options.DimTextOverride}"/>
                        <CheckBox Content="Размерным стилем" IsChecked="{Binding Options.DimStyle}"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <!-- Правая колонка -->
            <StackPanel Grid.Column="2">
                <GroupBox Header="ОКРУЖНОСТИ">
                    <CheckBox Content="Радиусом" IsChecked="{Binding Options.CircleRadius}"/>
                </GroupBox>
                <GroupBox Header="ОДНОСТРОЧНЫЙ ТЕКСТ">
                    <StackPanel>
                        <CheckBox Content="Содержимым текста" IsChecked="{Binding Options.TextContent}"/>
                        <CheckBox Content="Текстовым стилем" IsChecked="{Binding Options.TextStyle}"/>
                        <CheckBox Content="Высотой текста" IsChecked="{Binding Options.TextHeight}"/>
                        <CheckBox Content="Количеством символов" IsChecked="{Binding Options.TextLength}"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="МНОГОСТРОЧНЫЙ ТЕКСТ">
                    <StackPanel>
                        <CheckBox Content="Содержимым текста" IsChecked="{Binding Options.MTextContent}"/>
                        <CheckBox Content="Текстовым стилем" IsChecked="{Binding Options.MTextStyle}"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="ШТРИХОВКИ">
                    <StackPanel>
                        <CheckBox Content="Образцом штриховки" IsChecked="{Binding Options.HatchPattern}"/>
                        <CheckBox Content="Масштабом штриховки" IsChecked="{Binding Options.HatchScale}"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="ПОЛИЛИНИИ">
                    <StackPanel>
                        <CheckBox Content="Длиной полилинии" IsChecked="{Binding Options.PolylineLength}"/>
                        <CheckBox Content="Глобальной шириной" IsChecked="{Binding Options.PolylineGlobalWidth}"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Grid>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <CheckBox Content="Запомнить настройки" IsChecked="{Binding Options.RememberSettings}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Сохранить (Выбрать)" Command="{Binding ExecuteCommand}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>