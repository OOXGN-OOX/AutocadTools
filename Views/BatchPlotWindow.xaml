<Window x:Class="AutocadTools.Views.BatchPlotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AutocadTools.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        x:Name="TheWindow"
        Title="Autocad Tools - Пакетная печать форматов"
        Height="550" Width="950"
        MinHeight="400" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F5F5F5">

    <!-- DataContext задаётся в code-behind (BatchPlotWindow.xaml.cs). -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:InverseBoolConverter x:Key="InverseBool"/>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#F3F3F3"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Хэндл протяжки (нижний правый угол ячейки "Лист") -->
        <Style x:Key="ExcelFillThumb" TargetType="Thumb">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Cursor" Value="Cross"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="#0078D4"
                                BorderBrush="White"
                                BorderThickness="1"
                                CornerRadius="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Показываем хэндл, когда мышь над ячейкой -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=IsMouseOver}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель статуса -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="3"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="📊"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           FontWeight="Bold"
                           FontSize="13"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <!-- ПРАВАЯ ЧАСТЬ: кнопки + индикатор -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Button Content="✏ Указать форматку"
                                Command="{Binding SetFormatkaCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Height="28"
                                Margin="0,0,8,0"
                                Padding="10,3"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                ToolTip="Выбери блок в чертеже: его имя и слой станут текущим фильтром поиска форматков."/>

                        <!-- УДАЛЕНО: '📦 Все форматки' -->

                        <Button Content="✅ Выбрать форматки"
                                Command="{Binding SelectFormatkiCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Height="28"
                                Padding="10,3"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                ToolTip="В разработке."/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <ProgressBar IsIndeterminate="True"
                                     Width="120"
                                     Height="20"
                                     Margin="0,0,10,0"/>
                        <TextBlock Text="Обработка..."
                                   FontStyle="Italic"
                                   VerticalAlignment="Center"
                                   Foreground="#666666"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Таблица -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="3">

            <DataGrid ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Extended"
                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                      AlternatingRowBackground="#F9F9F9"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      MinRowHeight="34"
                      RowHeight="{x:Static sys:Double.NaN}"
                      FontSize="12">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F0F0F0"/>
                        <Setter Property="Foreground" Value="#333333"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderBrush" Value="#DDDDDD"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>

                    <!-- 1) Общий чекбокс в шапке + чекбокс в строке -->
                    <DataGridTemplateColumn Width="50">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox IsThreeState="True"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding DataContext.IsAllSelected,
                                                             RelativeSource={RelativeSource AncestorType=Window},
                                                             Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="Выбрать/снять все (три-состояния: всё/часть/ничего)."/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 2) Наименование (шире + перенос строк + авто-высота) -->
                    <DataGridTextColumn Header="Наименование"
                                        Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                        Width="4*"
                                        IsReadOnly="False">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="TextTrimming" Value="None"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="AcceptsReturn" Value="True"/>
                                <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <!-- 3) Лист (Excel-подобная протяжка через Thumb) -->
                    <DataGridTemplateColumn Header="Лист" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding SheetNumber}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"/>

                                    <Thumb Style="{StaticResource ExcelFillThumb}"
                                           DragStarted="SheetFill_DragStarted"
                                           DragDelta="SheetFill_DragDelta"
                                           DragCompleted="SheetFill_DragCompleted"
                                           Tag="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBox Text="{Binding SheetNumber, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             TextAlignment="Center"/>

                                    <Thumb Style="{StaticResource ExcelFillThumb}"
                                           DragStarted="SheetFill_DragStarted"
                                           DragDelta="SheetFill_DragDelta"
                                           DragCompleted="SheetFill_DragCompleted"
                                           Tag="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- 4) Формат -->
                    <DataGridTemplateColumn Header="Формат" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Padding="8,4">
                                    <TextBlock Text="{Binding Format}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#333333"/>
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="Нестандартный">
                                                        <Setter Property="Foreground" Value="#DC3545"/>
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                    </Trigger>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Foreground" Value="#999999"/>
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.AllFormatNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding Format, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="4,2"
                                          VerticalContentAlignment="Center"
                                          Padding="6,4"
                                          IsDropDownOpen="True">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- 5) Статус (уже) -->
                    <DataGridTextColumn Header="Статус"
                                        Binding="{Binding Status, Mode=OneWay}"
                                        Width="120"
                                        IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#333333"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="OK">
                                        <Setter Property="Foreground" Value="#28A745"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="Готово">
                                        <Setter Property="Foreground" Value="#28A745"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="Ошибка">
                                        <Setter Property="Foreground" Value="#DC3545"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="Ошибка валидации">
                                        <Setter Property="Foreground" Value="#DC3545"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="PlotInfo Ошибка">
                                        <Setter Property="Foreground" Value="#DC3545"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="Публикация...">
                                        <Setter Property="Foreground" Value="#FFC107"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="Печать...">
                                        <Setter Property="Foreground" Value="#0078D4"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="Готов">
                                        <Setter Property="Foreground" Value="#6C757D"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Нижняя панель кнопок -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="3"
                Padding="10"
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Grid.Column="0">

                    <Button Content="🔄 Обновить"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Width="110"
                            Height="32"
                            Margin="0,0,8,0"
                            ToolTip="Перезагрузить список блоков из чертежа"/>

                    <!-- УДАЛЕНО: '☑ Все' и '☐ Снять' (заменены чекбоксом в шапке таблицы) -->
                    <!-- УДАЛЕНО: разделитель для этих кнопок -->

                    <Button Content="💾 Обновить атрибуты"
                            Command="{Binding UpdateAttributesCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Width="160"
                            Height="32"
                            Margin="8,0,8,0"
                            ToolTip="Записать изменения в чертеж AutoCAD"/>

                    <!-- УДАЛЕНО: '📄 По листам' -->
                </StackPanel>

                <!-- было: один Button Grid.Column="1" ... -->

                <StackPanel Grid.Column="1"
            Orientation="Horizontal"
            VerticalAlignment="Center">

                    <CheckBox Content="В фоне"
              IsChecked="{Binding PlotInBackground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              VerticalAlignment="Center"
              Margin="0,0,10,0"
              ToolTip="Управляет BACKGROUNDPLOT: включено = публикация/печать в фоне." />

                    <Button Content="📑 Печать"
            Command="{Binding PlotCommand}"
            Style="{StaticResource ModernButton}"
            Width="150"
            Height="36"
            FontWeight="Bold"
            FontSize="13"
            ToolTip="Печать выбранных листов в PDF"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>
