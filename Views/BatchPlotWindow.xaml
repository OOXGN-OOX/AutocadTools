<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:AutocadTools.ViewModels" xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Class="AutocadTools.Views.BatchPlotWindow" mc:Ignorable="d" x:Name="TheWindow" Title="Пакетная печать" Height="680" Width="1000" MinHeight="460" MinWidth="900" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Style="{DynamicResource ToolWindow}">
    <!-- DataContext задаётся в code-behind (BatchPlotWindow.xaml.cs). -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <vm:InverseBoolConverter x:Key="InverseBool"/>
            <Style x:Key="ExcelFillThumb" TargetType="Thumb">
                <Setter Property="Width" Value="10"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Bottom"/>
                <Setter Property="Cursor" Value="Cross"/>
                <Setter Property="Opacity" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Background="{DynamicResource AccentColor}" BorderBrush="{DynamicResource ControlBackground}" BorderThickness="1" CornerRadius="1"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- Показываем хэндл, когда мышь над ячейкой -->
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=IsMouseOver}" Value="True">
                        <Setter Property="Opacity" Value="1"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Пакетная печать" Style="{StaticResource TitleStyle}"/>
            <TextBlock Text="Проверьте состав листов, нумерацию и форматы перед выпуском PDF." Style="{StaticResource DescriptionStyle}"/>
        </StackPanel>
        <!-- Панель статуса -->
        <Border Grid.Row="1" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource Divider}" BorderThickness="0" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <!-- ПРАВАЯ ЧАСТЬ: кнопки + индикатор -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Указать образец" Command="{Binding SetFormatkaCommand}" Style="{StaticResource {x:Type Button}}" MinHeight="32" Margin="0,0,8,0" Padding="10,3" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" ToolTip="Укажите блок рамки. Его имя и слой задают фильтр поиска."/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <ProgressBar IsIndeterminate="True" Width="120" Height="20" Margin="0,0,10,0"/>
                        <TextBlock Text="Обработка..." FontStyle="Italic" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <!-- Таблица -->
        <Border Grid.Row="2" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource Divider}" BorderThickness="0" CornerRadius="5">
            <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" AlternatingRowBackground="{DynamicResource ControlBackground}" GridLinesVisibility="Horizontal" HeadersVisibility="Column" MinRowHeight="34" RowHeight="{x:Static sys:Double.NaN}" FontSize="13">
                <DataGrid.Columns>
                    <!-- 1) Общий чекбокс в шапке + чекбокс в строке -->
                    <DataGridTemplateColumn Width="50">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox IsThreeState="True" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding DataContext.IsAllSelected,                                                              RelativeSource={RelativeSource AncestorType=Window},                                                              Mode=TwoWay,                                                              UpdateSourceTrigger=PropertyChanged}" ToolTip="Выбрать/снять все (три-состояния: всё/часть/ничего)."/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- 2) Наименование (шире + перенос строк + авто-высота) -->
                    <DataGridTextColumn Header="Наименование" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="4*" IsReadOnly="False">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="TextTrimming" Value="None"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="AcceptsReturn" Value="True"/>
                                <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    <!-- 3) Лист (Excel-подобная протяжка через Thumb) -->
                    <DataGridTemplateColumn Header="Лист" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding SheetNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <Thumb Style="{StaticResource ExcelFillThumb}" DragStarted="SheetFill_DragStarted" DragDelta="SheetFill_DragDelta" DragCompleted="SheetFill_DragCompleted" Tag="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBox Text="{Binding SheetNumber, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextAlignment="Center"/>
                                    <Thumb Style="{StaticResource ExcelFillThumb}" DragStarted="SheetFill_DragStarted" DragDelta="SheetFill_DragDelta" DragCompleted="SheetFill_DragCompleted" Tag="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <!-- 4) Формат -->
                    <DataGridTemplateColumn Header="Формат" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Padding="8,4">
                                    <TextBlock Text="{Binding Format}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="Нестандартный">
                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                    </Trigger>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.AllFormatNames, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Format, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="4,2" VerticalContentAlignment="Center" Padding="6,4" IsDropDownOpen="True">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <!-- 5) Статус (уже) -->
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status, Mode=OneWay}" Width="120" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="OK">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="Готово">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="Ошибка">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="Ошибка валидации">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="PlotInfo Ошибка">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="Публикация...">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="Печать...">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="Готов">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <!-- Нижняя панель кнопок -->
        <Border Grid.Row="3" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource Divider}" BorderThickness="0" CornerRadius="5" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Column="0">
                    <Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource {x:Type Button}}" Width="110" Height="32" Margin="0,0,8,0" ToolTip="Перезагрузить список блоков из чертежа"/>
                    <Button Content="Записать атрибуты" Command="{Binding UpdateAttributesCommand}" Style="{StaticResource {x:Type Button}}" Width="160" Height="32" Margin="8,0,8,0" ToolTip="Записать изменения в чертеж AutoCAD"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Фоновая печать" IsChecked="{Binding PlotInBackground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Управляет BACKGROUNDPLOT: включено = публикация/печать в фоне."/>
                    <Button Content="Печать PDF" Command="{Binding PlotCommand}" Style="{StaticResource PrimaryButton}" Width="150" Height="36" FontWeight="Bold" FontSize="13" ToolTip="Печать выбранных листов в PDF"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
