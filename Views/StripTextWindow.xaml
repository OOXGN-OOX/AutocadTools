<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:AutocadTools.ViewModels" x:Class="AutocadTools.Views.StripTextWindow" mc:Ignorable="d" Title="Сброс форматирования текста" Height="650" Width="860" MinHeight="610" MinWidth="820" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Style="{DynamicResource ToolWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Сброс форматирования" Style="{StaticResource TitleStyle}"/>
            <TextBlock Text="Верните тексту свойства стиля, удалив выбранные переопределения." Style="{StaticResource DescriptionStyle}"/>
        </StackPanel>
        <!-- Preview Section -->
        <GroupBox Grid.Row="1" Header="Пример форматирования" Margin="0,0,0,10" Height="92">
            <Border Margin="0,8,0,0" Background="{DynamicResource InputBackground}">
                <TextBlock Text="Вентиляция приточная П1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <!-- Базовые стили (имитация "грязного" текста) -->
                            <Setter Property="Foreground" Value="#F0A5A0"/>
                            <Setter Property="FontFamily" Value="Impact"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontStyle" Value="Italic"/>
                            <Setter Property="TextDecorations" Value="Underline"/>
                            <Style.Triggers>
                                <!-- Если галочка "Цвет" включена -> Сбрасываем в черный -->
                                <DataTrigger Binding="{Binding Options.Color}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                </DataTrigger>
                                <!-- Если галочка "Шрифт" включена -> Сбрасываем в Segoe UI -->
                                <DataTrigger Binding="{Binding Options.Font}" Value="True">
                                    <Setter Property="FontFamily" Value="Segoe UI"/>
                                </DataTrigger>
                                <!-- Если галочка "Вес/Толщина" (имитируем через Height/Width) включена -> Normal -->
                                <DataTrigger Binding="{Binding Options.Width}" Value="True">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                </DataTrigger>
                                <!-- Если галочка "Наклон" включена -> Normal -->
                                <DataTrigger Binding="{Binding Options.Oblique}" Value="True">
                                    <Setter Property="FontStyle" Value="Normal"/>
                                </DataTrigger>
                                <!-- Если галочка "Подчеркивание" включена -> None -->
                                <DataTrigger Binding="{Binding Options.Underline}" Value="True">
                                    <Setter Property="TextDecorations" Value="{x:Null}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Визуализация рамки -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="2"/>
                        <!-- Рамка есть -->
                        <Setter Property="BorderBrush" Value="{DynamicResource TextSecondary}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Options.Frame}" Value="True">
                                <Setter Property="BorderThickness" Value="0"/>
                                <!-- Рамка удалена -->
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </GroupBox>
        <!-- Settings Checkbox -->
        <CheckBox Grid.Row="2" Content="Запомнить настройки" IsChecked="{Binding Options.RememberSettings}" Margin="0,0,0,5"/>
        <!-- Options Area -->
        <GroupBox Grid.Row="3" Header="Удалить форматирование">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Col 1 -->
                    <StackPanel Grid.Column="0">
                        <CheckBox Content="Выравнивание" IsChecked="{Binding Options.Alignment}"/>
                        <CheckBox Content="Цвет" IsChecked="{Binding Options.Color}"/>
                        <CheckBox Content="Шрифт" IsChecked="{Binding Options.Font}"/>
                        <CheckBox Content="Высота" IsChecked="{Binding Options.Height}"/>
                        <CheckBox Content="Перенос строки" IsChecked="{Binding Options.LineFeed}"/>
                        <CheckBox Content="Неразрывный пробел" IsChecked="{Binding Options.NonBreakingSpace}"/>
                        <CheckBox Content="Наклон" IsChecked="{Binding Options.Oblique}"/>
                    </StackPanel>
                    <!-- Col 2 -->
                    <StackPanel Grid.Column="1">
                        <CheckBox Content="Надчеркивание" IsChecked="{Binding Options.Overline}"/>
                        <CheckBox Content="Абзац" IsChecked="{Binding Options.Paragraph}"/>
                        <CheckBox Content="Дроби" IsChecked="{Binding Options.Stacking}"/>
                        <CheckBox Content="Табуляция" IsChecked="{Binding Options.Tabs}"/>
                        <CheckBox Content="Межбуквенный интервал" IsChecked="{Binding Options.Tracking}"/>
                        <CheckBox Content="Подчеркивание" IsChecked="{Binding Options.Underline}"/>
                        <CheckBox Content="Ширина символов" IsChecked="{Binding Options.Width}"/>
                    </StackPanel>
                    <!-- Col 3 -->
                    <StackPanel Grid.Column="2">
                        <CheckBox Content="Маскировка фона" IsChecked="{Binding Options.BackgroundMask}"/>
                        <CheckBox Content="Поля (в текст)" IsChecked="{Binding Options.Fields}"/>
                        <CheckBox Content="Колонки" IsChecked="{Binding Options.Columns}"/>
                        <CheckBox Content="Рамка текста" IsChecked="{Binding Options.Frame}"/>
                    </StackPanel>
                    <!-- Col 4 (Buttons) -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Top" Margin="10,0,0,0">
                        <Button Content="Выбрать все" Command="{Binding SelectAllCommand}" Width="100" Margin="0,0,0,5" Padding="5"/>
                        <Button Content="Снять все" Command="{Binding ClearAllCommand}" Width="100" Padding="5"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </GroupBox>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="104" Margin="0,0,8,0"/>
            <Button Content="Сбросить" Command="{Binding OkCommand}" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="104"/>
        </StackPanel>
    </Grid>
</Window>
