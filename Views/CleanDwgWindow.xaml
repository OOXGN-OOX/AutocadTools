<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AutocadTools.Views.CleanDwgWindow" Title="Очистка чертежа" Width="740" Height="660" MinWidth="700" MinHeight="620" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Style="{DynamicResource ToolWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Очистка чертежа" Style="{StaticResource TitleStyle}"/>
            <TextBlock Text="Выберите объекты и служебные данные для удаления." Style="{StaticResource DescriptionStyle}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <GroupBox Header="Объекты">
                        <StackPanel>
                            <CheckBox Content="Удалить точки" IsChecked="{Binding Options.Points}"/>
                            <CheckBox Content="Удалить маскировки" IsChecked="{Binding Options.Wipeouts}"/>
                            <CheckBox Content="Удалить пустой текст" IsChecked="{Binding Options.BlankText}"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Слои и таблицы">
                        <StackPanel>
                            <CheckBox Content="Удалить группы" IsChecked="{Binding Options.Groups}"/>
                            <CheckBox Content="Удалить фильтры слоев" IsChecked="{Binding Options.LayerFilters}"/>
                            <CheckBox Content="Удалить согласованные слои" IsChecked="{Binding Options.LayerReconcile}"/>
                            <CheckBox Content="Удалить RegApps" IsChecked="{Binding Options.RegApps}"/>
                            <CheckBox Content="Удалить список масштабов" IsChecked="{Binding Options.ScaleList}"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <GroupBox Header="Данные чертежа">
                        <StackPanel>
                            <CheckBox Content="Удалить VBA макросы" IsChecked="{Binding Options.VbaMacros}"/>
                            <CheckBox Content="Удалить стили линий DGN" IsChecked="{Binding Options.DgnLineStyles}"/>
                            <CheckBox Content="Удалить сторонние словари" IsChecked="{Binding Options.Dictionaries}"/>
                            <CheckBox Content="Очистить историю 3D тел" IsChecked="{Binding Options.SolidHistory}"/>
                            <CheckBox Content="Удалить настройки печати" IsChecked="{Binding Options.PageSetups}"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Дополнительные действия">
                        <StackPanel>
                            <CheckBox Content="Очистить все (_PURGE)" IsChecked="{Binding Options.PurgeAll}" FontWeight="SemiBold"/>
                            <CheckBox Content="Проверка ошибок (_AUDIT)" IsChecked="{Binding Options.Audit}"/>
                            <CheckBox Content="Сохранить документ" IsChecked="{Binding Options.SaveDoc}"/>
                            <CheckBox Content="Запомнить настройки" IsChecked="{Binding Options.RememberSettings}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <ContentControl Grid.Row="2">
            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,20,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Content="Выбрать все" Command="{Binding SelectAllCommand}" MinWidth="104" Margin="8,0,0,0"/>
                        <Button Content="Снять все" Command="{Binding ClearAllCommand}" MinWidth="104" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Отмена" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="104" Margin="8,0,0,0"/>
                        <Button Content="Очистить" Command="{Binding ExecuteCommand}" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="104" Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </ContentControl>
    </Grid>
</Window>
