<Window x:Class="AutocadTools.Views.CleanDwgWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CleanDWG 1.3" 
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="ControlBackground" Color="#2D2D30"/>
        <SolidColorBrush x:Key="ControlBorder" Color="#434346"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="CheckedColor" Color="#666666"/>

        <!-- CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="checkBorder" Width="16" Height="16" 
                                    Background="#252526" BorderBrush="{StaticResource ControlBorder}" 
                                    BorderThickness="1" CornerRadius="3" VerticalAlignment="Center">
                                <Path x:Name="checkMark" Data="M2,5 L5,8 L10,2" 
                                      Stroke="{StaticResource TextPrimary}" StrokeThickness="2" 
                                      Visibility="Collapsed" Margin="1"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="checkBorder" Property="Background" Value="{StaticResource CheckedColor}"/>
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="{StaticResource CheckedColor}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GroupBox Style -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{TemplateBinding Header}" 
                                       Foreground="{StaticResource TextSecondary}" 
                                       FontSize="11" FontWeight="SemiBold" 
                                       Margin="0,0,0,6"/>
                            <Border Grid.Row="1" Background="#252526" 
                                    BorderBrush="{StaticResource ControlBorder}" 
                                    BorderThickness="1" CornerRadius="6" Padding="12,8">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4E4E52"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#666666"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#555555"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Очистка чертежа" 
                   Foreground="{StaticResource TextPrimary}" 
                   FontWeight="Bold" FontSize="18" Margin="0,0,0,16"/>

        <!-- Options Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column -->
            <StackPanel Grid.Column="0" MinWidth="220">
                <GroupBox Header="ВИЗУАЛЬНЫЕ ОБЪЕКТЫ">
                    <StackPanel>
                        <CheckBox Content="Удалить точки" IsChecked="{Binding Options.Points}"/>
                        <CheckBox Content="Удалить маскировки" IsChecked="{Binding Options.Wipeouts}"/>
                        <CheckBox Content="Удалить пустой текст" IsChecked="{Binding Options.BlankText}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="СЛОВАРИ И ТАБЛИЦЫ">
                    <StackPanel>
                        <CheckBox Content="Удалить группы" IsChecked="{Binding Options.Groups}"/>
                        <CheckBox Content="Удалить фильтры слоев" IsChecked="{Binding Options.LayerFilters}"/>
                        <CheckBox Content="Удалить согласованные слои" IsChecked="{Binding Options.LayerReconcile}"/>
                        <CheckBox Content="Удалить RegApps" IsChecked="{Binding Options.RegApps}"/>
                        <CheckBox Content="Удалить список масштабов" IsChecked="{Binding Options.ScaleList}"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <!-- Right Column -->
            <StackPanel Grid.Column="2" MinWidth="220">
                <GroupBox Header="МУСОР">
                    <StackPanel>
                        <CheckBox Content="Удалить VBA макросы" IsChecked="{Binding Options.VbaMacros}"/>
                        <CheckBox Content="Удалить стили линий DGN" IsChecked="{Binding Options.DgnLineStyles}"/>
                        <CheckBox Content="Удалить сторонние словари" IsChecked="{Binding Options.Dictionaries}"/>
                        <CheckBox Content="Очистить историю 3D тел" IsChecked="{Binding Options.SolidHistory}"/>
                        <CheckBox Content="Удалить настройки печати" IsChecked="{Binding Options.PageSetups}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="ДЕЙСТВИЯ">
                    <StackPanel>
                        <CheckBox Content="Очистить все (_PURGE)" IsChecked="{Binding Options.PurgeAll}" FontWeight="SemiBold"/>
                        <CheckBox Content="Проверка ошибок (_AUDIT)" IsChecked="{Binding Options.Audit}"/>
                        <CheckBox Content="Сохранить документ" IsChecked="{Binding Options.SaveDoc}"/>
                        <CheckBox Content="Запомнить настройки" IsChecked="{Binding Options.RememberSettings}" Margin="0,10,0,0"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Grid>

        <!-- Buttons -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Выбрать все" Command="{Binding SelectAllCommand}" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="Сбросить" Command="{Binding ClearAllCommand}"/>
            
            <Button Grid.Column="3" Content="ОК" Command="{Binding ExecuteCommand}" 
                    Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0,0,8,0" MinWidth="80"/>
            <Button Grid.Column="4" Content="Отмена" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="80"/>
        </Grid>
    </Grid>
</Window>