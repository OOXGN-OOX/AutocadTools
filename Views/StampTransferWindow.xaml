<Window x:Class="AutocadTools.Views.StampTransferWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:AutocadTools.UI" Title="Записать поля штампа" Width="760" Height="450"
 MinWidth="420" MinHeight="280" FontFamily="Segoe UI" FontSize="13" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}" Style="{DynamicResource ToolWindow}">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <DockPanel Margin="16" Background="{DynamicResource WindowBackground}">
  <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
   <CheckBox x:Name="EmptyValues" Content="Пустые" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="Создать полный набор полей с пробелами, без значений из исходного штампа." Checked="EmptyChanged" Unchecked="EmptyChanged"/>
   <Button Content="Записать" Click="WriteSelected" Margin="0,0,8,0"/>
   <Button Content="Закрыть" Click="CloseClick" IsCancel="True"/>
  </WrapPanel>
  <TextBlock x:Name="ResultText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0"/>
  <TextBlock DockPanel.Dock="Top" Text="Выберите один или несколько открытых документов. «Пустые» — создать поля с пробелами; без галочки — перенести значения. После записи сохраните документы обычным способом." TextWrapping="Wrap" Margin="0,0,0,12"/>
  <DataGrid x:Name="TargetsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" HeadersVisibility="Column">
   <DataGrid.Resources>
    <Style TargetType="DataGridColumnHeader">
     <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
     <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
     <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
     <Setter Property="BorderThickness" Value="0,0,1,1"/>
     <Setter Property="Padding" Value="8"/>
    </Style>
   </DataGrid.Resources>
   <DataGrid.Columns>
    <DataGridTemplateColumn Header="Выбрать" Width="75">
     <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTextColumn Header="Документ" Binding="{Binding Name}" IsReadOnly="True" Width="180"/>
    <DataGridTextColumn Header="Путь" Binding="{Binding Location}" IsReadOnly="True" Width="*" MinWidth="180"/>
    <DataGridTextColumn Header="Результат" Binding="{Binding Status}" IsReadOnly="True" Width="150"/>
   </DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</Window>
