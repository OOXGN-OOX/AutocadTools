<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AutocadTools.Views.AboutWindow" Title="О программе" Width="540" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Style="{DynamicResource ToolWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,24">
            <Path Data="F0 M137 0H221C296.66 0 358 61.34 358 137C358 212.66 296.66 274 221 274H137C61.34 274 0 212.66 0 137C0 61.34 61.34 0 137 0Z M138 49H220C268.6 49 308 88.4 308 137C308 185.6 268.6 225 220 225H138C89.4 225 50 185.6 50 137C50 88.4 89.4 49 138 49Z M508 0H592C667.66 0 729 61.34 729 137C729 212.66 667.66 274 592 274H508C432.34 274 371 212.66 371 137C371 61.34 432.34 0 508 0Z M509 49H591C639.6 49 679 88.4 679 137C679 185.6 639.6 225 591 225H509C460.4 225 421 185.6 421 137C421 88.4 460.4 49 509 49Z M710 0H789L1079 274H998L891 176L785 274H701L854 137Z M1003 0H1086L947 121L908 82Z M1193 0H1366V49H1193C1145 49 1106 88 1106 137C1106 186 1145 225 1193 225H1316V163H1205V115H1333C1351 115 1366 129 1366 148V274H1193C1117 274 1056 213 1056 137C1056 61 1117 0 1193 0Z M1404 274V0H1444L1690 214V0H1747V274H1680L1461 70V274Z" Fill="{DynamicResource AccentColor}" Width="104" Height="18" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,24"/>
            <TextBlock Text="Autocad Tools" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
            <TextBlock Text="Оформление чертежей и выпуск документации" Foreground="{DynamicResource TextSecondary}" Margin="0,12,0,0"/>
        </StackPanel>
        <GroupBox Grid.Row="1" Header="Обновления">
            <StackPanel Margin="0,10,0,0">
                <CheckBox x:Name="AutoUpdateCheck" Content="Проверять обновления автоматически" Checked="UpdateSettingsChanged" Unchecked="UpdateSettingsChanged"/>
                <CheckBox x:Name="AutoInstallUpdateCheck" Content="Устанавливать после закрытия AutoCAD" Checked="UpdateSettingsChanged" Unchecked="UpdateSettingsChanged"/>
                <TextBlock Text="Установка начнётся, когда закрыты все окна AutoCAD." Style="{StaticResource LabelStyle}" Margin="20,0,0,6"/>
                <CheckBox x:Name="PrereleaseUpdateCheck" Content="Включать предварительные выпуски" Checked="UpdateSettingsChanged" Unchecked="UpdateSettingsChanged"/>
            </StackPanel>
        </GroupBox>
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="© 2026 OOXGN" Style="{StaticResource LabelStyle}"/>
                <TextBlock Text="Некоммерческая лицензия" Style="{StaticResource LabelStyle}" Margin="0,10,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="1" VerticalAlignment="Center">
                <Hyperlink NavigateUri="https://github.com/OOXGN-OOX/AutocadTools" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{DynamicResource TextPrimary}">Проект на GitHub</Hyperlink>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
