<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(AutoCADVersion)' == '2027'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(AutoCADVersion)' != '2027'">net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings><Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Commands/MultiCopyCommand.cs" Link="MultiCopyCommand.cs" />
    <Compile Include="../../Services/MultiCopyLayout.cs" Link="MultiCopyLayout.cs" />
    <Compile Include="../../Services/MultiCopyService.cs" Link="MultiCopyService.cs" />
    <Reference Include="AcCoreMgd"><HintPath>C:\Program Files\Autodesk\AutoCAD $(AutoCADVersion)\accoremgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>C:\Program Files\Autodesk\AutoCAD $(AutoCADVersion)\acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcMgd"><HintPath>C:\Program Files\Autodesk\AutoCAD $(AutoCADVersion)\acmgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
