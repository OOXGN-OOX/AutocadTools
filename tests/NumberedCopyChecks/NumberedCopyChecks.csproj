<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AutoCADVersion Condition="'$(AutoCADVersion)' == ''">2026</AutoCADVersion>
    <TargetFramework Condition="'$(AutoCADVersion)' == '2027'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(AutoCADVersion)' != '2027'">net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings><Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Models/NumberedCopyOptions.cs" Link="NumberedCopyOptions.cs" />
    <Compile Include="../../Services/NumberedCopyText.cs" Link="NumberedCopyText.cs" />
    <Compile Include="../../Services/NumberedCopyService.cs" Link="NumberedCopyService.cs" />
    <Compile Include="../../Services/NumberedCopyPath.cs" Link="NumberedCopyPath.cs" />
    <Compile Include="../../Services/NumberedCopySettings.cs" Link="NumberedCopySettings.cs" />
    <Compile Include="../../Commands/NumberedCopyCommand.cs" Link="NumberedCopyCommand.cs" />
    <Compile Include="../../Views/NumberedCopyWindow.cs" Link="NumberedCopyWindow.cs" />
    <Compile Include="../../Views/UiTheme.cs" Link="UiTheme.cs" />
    <Page Include="../../Views/Styles.xaml" Link="Views/Styles.xaml" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <Reference Include="AcCoreMgd"><HintPath>C:\Program Files\Autodesk\AutoCAD $(AutoCADVersion)\accoremgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>C:\Program Files\Autodesk\AutoCAD $(AutoCADVersion)\acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcMgd"><HintPath>C:\Program Files\Autodesk\AutoCAD $(AutoCADVersion)\acmgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
