<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AutoCADVersion Condition="'$(AutoCADVersion)' == ''">2026</AutoCADVersion>
    <TargetFramework Condition="'$(AutoCADVersion)' == '2027'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(AutoCADVersion)' != '2027'">net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Models/DrawingSymbolOptions.cs" Link="DrawingSymbolOptions.cs" />
    <Compile Include="../../Models/DrawingSymbolCatalog.cs" Link="DrawingSymbolCatalog.cs" />
    <Compile Include="../../Services/DrawingAnnotationGeometry.cs" Link="DrawingAnnotationGeometry.cs" />
    <Compile Include="../../Services/DrawingSymbolGeometry.cs" Link="DrawingSymbolGeometry.cs" />
    <Compile Include="../../Services/DrawingSymbolService.cs" Link="DrawingSymbolService.cs" />
    <Reference Include="AcCoreMgd"><HintPath>C:\Program Files\Autodesk\AutoCAD $(AutoCADVersion)\accoremgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>C:\Program Files\Autodesk\AutoCAD $(AutoCADVersion)\acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcMgd"><HintPath>C:\Program Files\Autodesk\AutoCAD $(AutoCADVersion)\acmgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
